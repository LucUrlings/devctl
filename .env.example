# Run `id -u` and `id -g` on the Docker server.
PUID=1000
PGID=1000

# Absolute path on the Docker server. The TLDR command fills this automatically.
DATA_PATH=/opt/hermes-dev/data

# Official Hermes image. `docker compose pull` installs current updates.
HERMES_IMAGE=nousresearch/hermes-agent:latest

# Companion image published by this repository.
COMPANION_IMAGE=ghcr.io/lucurlings/devctl-companion:latest

# Existing Traefik installation.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_AUTH_MIDDLEWARE=oauth@file

# Create DNS records for all three names pointing to the Docker server.
CODE_HOST=code.example.com
DEV_HOST=dev.example.com
DASHBOARD_HOST=hermes.example.com

# Inner Hermes dashboard login. Generate the secret with: openssl rand -hex 32
# Keep this .env file private (chmod 600 .env).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Development servers must listen on 0.0.0.0 and this port inside companion.
DEV_PORT=3000
