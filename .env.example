HUB_IMAGE=ghcr.io/lucurlings/devctl-hub:latest
WORKSPACE_IMAGE=ghcr.io/lucurlings/devctl-workspace:latest
PROJECT_NAME=project
PROJECT_DIR=/srv/devctl/projects/project
REPO_URL=<repo>
REPO_BRANCH=
REPO_DEPTH=
SSH_PORT=22000
PREVIEW_PORT=3000
CODE_HOST=project.code.example.invalid
PREVIEW_HOST=project.dev.example.invalid
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_AUTH_MIDDLEWARE=google-oauth@docker
TRAEFIK_CERT_RESOLVER=
TRAEFIK_CODE_ROUTER=devctl-project-code
TRAEFIK_PREVIEW_ROUTER=devctl-project-preview
