#!/usr/bin/env bash
set -euo pipefail

slug=${1:-}
agent=${2:-shell}
if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]]; then
  echo "dev-enter: invalid project slug" >&2
  exit 2
fi
case "$agent" in
  codex|claude|shell) ;;
  *) echo "dev-enter: agent must be codex, claude, or shell" >&2; exit 2 ;;
esac
export HERDR_AGENT=$agent

mapfile -t matches < <(docker ps \
  --filter label=devctl.managed=true \
  --filter "label=devctl.project=$slug" \
  --format '{{.ID}}')
if [[ ${#matches[@]} -ne 1 ]]; then
  echo "dev-enter: expected exactly one running container for $slug; found ${#matches[@]}" >&2
  exit 1
fi

docker_args=(exec --interactive --tty --user developer --workdir "/srv/devctl/projects/$slug/repo")
for variable in HERDR_PANE_ID HERDR_TAB_ID HERDR_WORKSPACE_ID; do
  if [[ -n ${!variable:-} ]]; then
    docker_args+=(--env "$variable=${!variable}")
  fi
done
docker_args+=(--env HERDR_SOCKET_PATH=/run/herdr/herdr.sock)
case "$agent" in
  codex) command=(codex) ;;
  claude) command=(claude) ;;
  shell) command=(bash -l) ;;
esac
exec docker "${docker_args[@]}" "${matches[0]}" "${command[@]}"
