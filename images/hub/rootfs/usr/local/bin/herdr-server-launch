#!/usr/bin/env bash
set -euo pipefail
herdr server &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null || true' TERM
trap 'kill -INT "$pid" 2>/dev/null || true' INT
socket_ready=false
for _attempt in $(seq 1 100); do
  if [[ -S ${HERDR_SOCKET_PATH:?} ]]; then
    if chmod 0666 "$HERDR_SOCKET_PATH" 2>/dev/null; then
      socket_ready=true
      break
    fi
  fi
  kill -0 "$pid" 2>/dev/null || break
  sleep 0.1
done
if [[ "$socket_ready" != true ]]; then
  echo "herdr-server-launch: server socket did not become ready" >&2
  kill "$pid" 2>/dev/null || true
  wait "$pid" || true
  exit 1
fi
status=0
while kill -0 "$pid" 2>/dev/null; do
  wait "$pid" || status=$?
done
exit "$status"
