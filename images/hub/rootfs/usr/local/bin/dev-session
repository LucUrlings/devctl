#!/usr/bin/env bash
set -uo pipefail

slug=${1:-}
agent=${2:-}
mode=${3:-new}
[[ "$slug" =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || {
  echo "dev-session: invalid project slug" >&2
  exit 2
}
[[ $agent == codex || $agent == claude ]] || {
  echo "dev-session: agent must be codex or claude" >&2
  exit 2
}
[[ $mode == new || $mode == resume ]] || {
  echo "dev-session: mode must be new or resume" >&2
  exit 2
}

# Herdr reads this hint from the persistent foreground wrapper. Keeping this
# process alive prevents CCGram from losing the project topic if the child CLI
# exits because of a timeout, update, crash, or workspace restart.
export HERDR_AGENT=$agent
resume=false
[[ $mode == resume ]] && resume=true
delay=${DEV_SESSION_RESTART_DELAY:-2}
resume_failures=0

while true; do
  was_resume=$resume
  started=$SECONDS
  if [[ $resume == true && $agent == codex ]]; then
    dev-enter "$slug" "$agent" resume --last
  elif [[ $resume == true ]]; then
    dev-enter "$slug" "$agent" --continue
  else
    dev-enter "$slug" "$agent"
  fi
  status=$?

  # Preserve resume intent while the workspace is stopped or being recreated.
  # dev-enter uses EX_TEMPFAIL (75) when no matching container is running. Also
  # recheck after other failures to cover the small race where Docker stops the
  # container between discovery and `docker exec`.
  running_count=0
  while IFS= read -r container_id; do
    [[ -z $container_id ]] || running_count=$((running_count + 1))
  done < <(docker ps \
    --filter label=devctl.managed=true \
    --filter "label=devctl.project=$slug" \
    --format '{{.ID}}' 2>/dev/null)
  if [[ $status -eq 75 || $running_count -ne 1 ]]; then
    resume_failures=0
    printf '\n[devctl] workspace %s is unavailable; retrying in %ss\n' \
      "$slug" "$delay" >&2
    sleep "$delay"
    continue
  fi

  # A CLI that lived long enough to create/load a conversation can resume it.
  # Immediate failures (bad auth, unavailable container) retry a clean launch.
  if (( SECONDS - started >= 5 )); then
    resume=true
    resume_failures=0
  elif [[ $was_resume == true ]]; then
    # Tolerate brief Docker replacement races. Repeated immediate failures while
    # exactly one workspace is running indicate a missing/corrupt saved session.
    resume_failures=$((resume_failures + 1))
    if (( resume_failures >= 3 )); then
      resume=false
      resume_failures=0
    fi
  else
    resume_failures=0
  fi
  printf '\n[devctl] %s exited with status %s; restarting in %ss\n' \
    "$agent" "$status" "$delay" >&2
  sleep "$delay"
done
