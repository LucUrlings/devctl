#!/usr/bin/env python3
"""Small compatibility layer for CCGram 4.6.8's Herdr backend."""

from __future__ import annotations

from collections.abc import Callable
from typing import Any


_TELEGRAM_INJECTION_TTL_SECONDS = 6 * 60 * 60
_ATOMIC_PROMPT_AGENTS = frozenset({"claude", "codex"})


def _topic_key(
    user_id: int,
    window_id: str,
    thread_id: int,
    chat_id: int | None,
) -> tuple[int, int | None, int]:
    """Correlate by Telegram topic, which survives Herdr target re-keying."""
    del window_id
    return user_id, chat_id, thread_id


def _install_herdr_prompt(manager_class: type[Any], error_class: type[Exception]) -> None:
    """Use Herdr's bracketed-paste-aware atomic agent prompt operation."""
    if getattr(manager_class, "_devctl_atomic_prompt", False):
        return
    original_send: Callable[..., Any] = manager_class.send

    async def send(
        self: Any,
        window_id: str,
        text: str,
        *,
        enter: bool = True,
        literal: bool = True,
        raw: bool = False,
    ) -> bool:
        if not enter or not literal:
            return await original_send(
                self,
                window_id,
                text,
                enter=enter,
                literal=literal,
                raw=raw,
            )
        try:
            record = await self.guard_session_target(window_id)
        except error_class:
            return False
        if record.composite.agent.lower() not in _ATOMIC_PROMPT_AGENTS:
            return await original_send(
                self,
                window_id,
                text,
                enter=enter,
                literal=literal,
                raw=raw,
            )
        ok = await self._call_ok(["agent", "prompt", record.pane_id, text])
        if not ok:
            await self._after_action_failure(window_id)
        return ok

    manager_class.send = send
    manager_class._devctl_atomic_prompt = True


def install() -> None:
    """Apply the two narrow compatibility fixes before CCGram imports handlers."""
    from ccgram.handlers import telegram_origin
    from ccgram.multiplexer.herdr import HerdrError, HerdrManager

    # A prompt may remain queued while a long Codex turn completes. CCGram's
    # 30-second default then forgets it and posts the transcript back as a
    # spurious `user` message. A Telegram topic is also more stable than the
    # Herdr target ID, which may change when native session identity arrives.
    telegram_origin._PENDING_INJECTION_TTL_S = _TELEGRAM_INJECTION_TTL_SECONDS
    telegram_origin._key = _topic_key
    _install_herdr_prompt(HerdrManager, HerdrError)


if __name__ == "__main__":
    install()
    from ccgram.main import main

    main()
