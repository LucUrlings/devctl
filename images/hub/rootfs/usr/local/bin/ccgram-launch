#!/usr/bin/env bash
set -euo pipefail

token_file=${TELEGRAM_BOT_TOKEN_FILE:-/srv/devctl/secrets/telegram-bot-token}
if [[ ! -s $token_file ]]; then
  echo "ccgram-launch: bot-token file is missing or empty" >&2
  exit 1
fi
export TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=$(<"$token_file")
export HERDR_SOCKET_PATH=${HERDR_SOCKET_PATH:-/srv/devctl/herdr/run/herdr.sock}
exec runuser --user developer --preserve-environment -- ccgram
