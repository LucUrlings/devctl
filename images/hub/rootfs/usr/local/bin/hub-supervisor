#!/usr/bin/env python3
from __future__ import annotations

import os
import signal
import subprocess
import sys
import time

commands = [["herdr-server-launch"], ["ccgram-launch"]]
processes: list[subprocess.Popen[bytes]] = []
shutting_down = False
shutdown_started = 0.0


def start(command: list[str]) -> subprocess.Popen[bytes]:
    return subprocess.Popen(command, env=os.environ.copy())


def stop(signum: int, _frame: object) -> None:
    global shutting_down, shutdown_started
    shutting_down = True
    shutdown_started = time.monotonic()
    for process in processes:
        if process.poll() is None:
            process.send_signal(signum)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
processes = [start(command) for command in commands]
while True:
    if shutting_down:
        if all(process.poll() is not None for process in processes):
            raise SystemExit(0)
        if time.monotonic() - shutdown_started >= 8:
            for process in processes:
                if process.poll() is None:
                    process.kill()
            raise SystemExit(0)
        time.sleep(0.1)
        continue
    for index, process in enumerate(processes):
        code = process.poll()
        if code is not None:
            if commands[index] == ["herdr-server-launch"]:
                stop(signal.SIGTERM, None)
                print(f"hub-supervisor: Herdr exited with {code}", file=sys.stderr)
                raise SystemExit(code or 1)
            time.sleep(2)
            processes[index] = start(commands[index])
    time.sleep(1)
