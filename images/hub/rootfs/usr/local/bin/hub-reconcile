#!/usr/bin/env python3
"""Reconnect Docker workspaces to restored Herdr panes after a cold start."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

SLUG = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
AGENTS = {"codex", "claude"}
HERDR_CWD = "/srv/devctl/herdr"
READY_PATH = Path(os.getenv("DEVCTL_RECONCILED_PATH", "/run/devctl-herdr-reconciled"))
LOCK_PATH = Path(os.getenv("DEVCTL_RECONCILE_LOCK_PATH", "/srv/devctl/herdr/.reconcile.lock"))
STARTUP_GRACE_SECONDS = 10
STARTUP_DISCOVERY_SECONDS = 30


def log(message: str) -> None:
    print(f"hub-reconcile: {message}", file=sys.stderr, flush=True)


def run(args: list[str], *, timeout: float = 15) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"{' '.join(args[:3])}: {detail}")
    return result


def herdr(*args: str) -> dict[str, Any]:
    result = run(["herdr", *args])
    try:
        payload = json.loads(result.stdout)
        return payload["result"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise RuntimeError(f"invalid Herdr response for {' '.join(args)}") from exc


def running_projects(*, include_stopped: bool = False) -> tuple[dict[str, tuple[str, str]], bool]:
    docker_ps = ["docker", "ps"]
    if include_stopped:
        docker_ps.append("--all")
    ids = run(
        [
            *docker_ps,
            "--filter",
            "label=devctl.managed=true",
            "--filter",
            "label=devctl.project",
            "--format",
            "{{.ID}}",
        ]
    ).stdout.splitlines()
    projects: dict[str, list[tuple[str, str]]] = {}
    pending_or_invalid = False
    for container_id in ids:
        details = json.loads(run(["docker", "inspect", container_id]).stdout)[0]
        slug = details.get("Config", {}).get("Labels", {}).get("devctl.project", "")
        if not SLUG.fullmatch(slug):
            log(f"ignoring container {container_id}: invalid project label")
            pending_or_invalid = True
            continue
        if include_stopped and not details.get("State", {}).get("Running", False):
            status = details.get("State", {}).get("Status", "stopped")
            log(f"{slug}: workspace is {status}; waiting for Docker startup")
            pending_or_invalid = True
            continue
        health = details.get("State", {}).get("Health", {}).get("Status")
        if health != "healthy":
            log(f"{slug}: workspace is {health or 'missing a health check'}; waiting")
            pending_or_invalid = True
            continue
        agent = "none"
        for value in details.get("Config", {}).get("Env", []):
            if value.startswith("PROJECT_AGENT="):
                agent = value.removeprefix("PROJECT_AGENT=")
                break
        if agent not in {*AGENTS, "shell", "none"}:
            log(f"{slug}: ignoring invalid PROJECT_AGENT={agent!r}")
            pending_or_invalid = True
            continue
        projects.setdefault(slug, []).append((container_id, agent))

    unique: dict[str, tuple[str, str]] = {}
    for slug, matches in projects.items():
        if len(matches) != 1:
            log(f"{slug}: expected one healthy workspace container, found {len(matches)}")
            pending_or_invalid = True
            continue
        unique[slug] = matches[0]
    return unique, pending_or_invalid


def foreground(pane_id: str) -> list[dict[str, Any]]:
    return herdr("pane", "process-info", "--pane", pane_id)["process_info"].get(
        "foreground_processes", []
    )


def is_shell(processes: list[dict[str, Any]]) -> bool:
    if len(processes) != 1 or processes[0].get("name") not in {"sh", "bash", "zsh", "fish"}:
        return False
    argv = processes[0].get("argv", [])
    return not argv or all(str(argument).startswith("-") for argument in argv[1:])


def is_managed(processes: list[dict[str, Any]], slug: str, label: str) -> bool:
    if label == "shell":
        return any(process.get("name") == "docker" for process in processes)
    expected = ["/usr/local/bin/dev-session", slug, label]
    for process in processes:
        argv = process.get("argv", [])
        for index in range(max(0, len(argv) - len(expected) + 1)):
            if argv[index : index + len(expected)] == expected:
                return True
    return False


def is_live_agent(pane_id: str, label: str) -> bool:
    """Accept a live pre-wrapper agent while upgrading an existing deployment."""
    if label not in AGENTS:
        return False
    agents = herdr("agent", "list").get("agents", [])
    return any(
        agent.get("pane_id") == pane_id and agent.get("agent") == label
        for agent in agents
    )


def wait_for(pane_id: str, predicate: Any, seconds: float = 10) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        try:
            if predicate(foreground(pane_id)):
                return True
        except RuntimeError:
            pass
        time.sleep(0.2)
    return False


def pane_for_tab(workspace_id: str, tab_id: str) -> str | None:
    panes = [
        pane
        for pane in herdr("pane", "list", "--workspace", workspace_id).get("panes", [])
        if pane.get("tab_id") == tab_id
    ]
    if len(panes) != 1:
        return None
    return panes[0].get("pane_id")


def create_tab(workspace_id: str, label: str) -> str:
    result = herdr(
        "tab",
        "create",
        "--workspace",
        workspace_id,
        "--cwd",
        HERDR_CWD,
        "--label",
        label,
        "--no-focus",
    )
    return result["root_pane"]["pane_id"]


def ensure_tab(workspace_id: str, label: str) -> str | None:
    tabs = [
        tab
        for tab in herdr("tab", "list", "--workspace", workspace_id).get("tabs", [])
        if tab.get("label") == label
    ]
    if not tabs:
        return create_tab(workspace_id, label)
    if len(tabs) != 1:
        log(f"workspace {workspace_id}: multiple {label!r} tabs; skipping")
        return None
    pane_id = pane_for_tab(workspace_id, tabs[0]["tab_id"])
    if pane_id is None:
        log(f"workspace {workspace_id}: {label!r} tab does not contain exactly one pane")
    return pane_id


def launch(pane_id: str, slug: str, label: str) -> bool:
    processes = foreground(pane_id)
    if is_managed(processes, slug, label):
        return True
    # Older releases launched Codex and Claude directly. Preserve a live legacy
    # process instead of blocking hub readiness or replacing an active session.
    # When it eventually exits, the next pass sees an idle shell and installs the
    # persistent dev-session wrapper normally.
    if is_live_agent(pane_id, label):
        return True
    if not wait_for(pane_id, is_shell):
        log(f"{slug}/{label}: pane is busy with an unmanaged process; leaving it untouched")
        return False
    if label == "shell":
        command = f"exec dev-enter {slug} shell"
    else:
        command = f"exec dev-session {slug} {label} resume"
    # `pane run` succeeds without emitting the JSON envelope used by query APIs.
    run(["herdr", "pane", "run", pane_id, command])
    if not wait_for(pane_id, lambda processes: is_managed(processes, slug, label)):
        log(f"{slug}/{label}: process did not become ready")
        return False
    return True


def create_workspace(slug: str) -> tuple[str, str]:
    result = herdr(
        "workspace", "create", "--cwd", HERDR_CWD, "--label", slug, "--no-focus"
    )
    tab_id = result["tab"]["tab_id"]
    herdr("tab", "rename", tab_id, "shell")
    return result["workspace"]["workspace_id"], result["root_pane"]["pane_id"]


def reconcile_project(slug: str, desired_agent: str, workspaces: list[dict[str, Any]]) -> bool:
    matches = [workspace for workspace in workspaces if workspace.get("label") == slug]
    if len(matches) > 1:
        log(f"{slug}: multiple Herdr workspaces match; skipping")
        return False
    successful = True
    if matches:
        created = False
        workspace_id = matches[0]["workspace_id"]
        shell_pane = ensure_tab(workspace_id, "shell")
    else:
        created = True
        workspace_id, shell_pane = create_workspace(slug)
    if shell_pane:
        if not launch(shell_pane, slug, "shell"):
            successful = False
    else:
        successful = False

    tabs = herdr("tab", "list", "--workspace", workspace_id).get("tabs", [])
    agents = {tab.get("label") for tab in tabs if tab.get("label") in AGENTS}
    # PROJECT_AGENT is only a cold-start fallback when Herdr state is absent. Once a
    # workspace exists, its tab labels are authoritative so closing a tab stays closed.
    if created and desired_agent in AGENTS:
        agents.add(desired_agent)
    for agent in sorted(agents):
        pane_id = ensure_tab(workspace_id, agent)
        if pane_id:
            if not launch(pane_id, slug, agent):
                successful = False
        else:
            successful = False
    return successful


def reconcile(*, include_stopped: bool = False) -> bool:
    projects, pending_or_invalid = running_projects(include_stopped=include_stopped)
    workspaces = herdr("workspace", "list").get("workspaces", [])
    successful = not pending_or_invalid
    for slug, (_container_id, desired_agent) in sorted(projects.items()):
        try:
            if not reconcile_project(slug, desired_agent, workspaces):
                successful = False
        except (KeyError, RuntimeError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
            log(f"{slug}: {exc}")
            successful = False
    return successful


def reconcile_locked(*, include_stopped: bool = False) -> bool:
    descriptor = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(descriptor, "r+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return reconcile(include_stopped=include_stopped)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--watch", action="store_true")
    args = parser.parse_args()
    started = time.monotonic()
    while True:
        successful = False
        try:
            elapsed = time.monotonic() - started
            successful = reconcile_locked(
                include_stopped=args.watch and elapsed < STARTUP_DISCOVERY_SECONDS
            )
        except (RuntimeError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
            log(str(exc))
        # During a full server reboot, independently managed workspace containers
        # may appear a few seconds after the hub. Give them several reconciliation
        # passes before CCGram is allowed to audit its persisted topic bindings.
        if successful and (not args.watch or time.monotonic() - started >= STARTUP_GRACE_SECONDS):
            READY_PATH.touch(mode=0o600, exist_ok=True)
        if not args.watch:
            return 0 if successful else 1
        time.sleep(5)


if __name__ == "__main__":
    raise SystemExit(main())
