#!/usr/bin/env bash
set -euo pipefail
umask 077

mode=${1:-herdr}
case "$mode" in
  herdr)
    install -d -m 0755 /srv/devctl/herdr /srv/devctl/herdr/run
    install -d -o developer -g developer -m 0700 \
      /srv/devctl/shared/codex /srv/devctl/shared/claude /srv/devctl/shared/gh
    # Official Herdr hooks publish stable native session IDs. CCGram uses those
    # IDs to keep Telegram bindings stable when Herdr recreates pane terminals.
    runuser --user developer -- env \
      HOME=/home/developer \
      CODEX_HOME=/srv/devctl/shared/codex \
      CLAUDE_CONFIG_DIR=/srv/devctl/shared/claude \
      herdr integration install codex >/dev/null
    runuser --user developer -- env \
      HOME=/home/developer \
      CODEX_HOME=/srv/devctl/shared/codex \
      CLAUDE_CONFIG_DIR=/srv/devctl/shared/claude \
      herdr integration install claude >/dev/null
    exec /usr/local/bin/herdr-server-launch
    ;;
  ccgram)
    [[ ${CCGRAM_MULTIPLEXER:-} == herdr ]] || {
      echo "hub-entrypoint: CCGRAM_MULTIPLEXER must be herdr" >&2
      exit 2
    }
    [[ ${ALLOWED_USERS:-} =~ ^[0-9]+(,[0-9]+)*$ ]] || {
      echo "hub-entrypoint: ALLOWED_USERS must be comma-separated numeric user IDs" >&2
      exit 2
    }
    [[ ${CCGRAM_GROUP_ID:-} =~ ^-100[0-9]+$ ]] || {
      echo "hub-entrypoint: CCGRAM_GROUP_ID must be a supergroup ID beginning with -100" >&2
      exit 2
    }
    token_file=${TELEGRAM_BOT_TOKEN_FILE:-/srv/devctl/secrets/telegram-bot-token}
    [[ -s $token_file ]] || {
      echo "hub-entrypoint: Telegram bot token file is missing or empty" >&2
      exit 2
    }
    [[ $(stat -c '%a' -- "$token_file") == 600 ]] || {
      echo "hub-entrypoint: Telegram bot token file must have mode 0600" >&2
      exit 2
    }
    install -d -o developer -g developer -m 0700 \
      /srv/devctl/ccgram /srv/devctl/shared/codex /srv/devctl/shared/claude
    runuser --user developer -- env \
      HOME=/home/developer \
      CLAUDE_CONFIG_DIR=/srv/devctl/shared/claude \
      CCGRAM_DIR=/srv/devctl/ccgram \
      ccgram hook --provider claude --install >/dev/null
    runuser --user developer -- env \
      HOME=/home/developer \
      CCGRAM_DIR=/srv/devctl/ccgram \
      ccgram hook --provider codex --install >/dev/null
    # CCGram currently writes the deprecated `codex_hooks` feature alias.
    # Re-running the official Herdr installer preserves both hooks while
    # migrating the shared Codex config to the canonical `hooks` key.
    runuser --user developer -- env \
      HOME=/home/developer \
      CODEX_HOME=/srv/devctl/shared/codex \
      herdr integration install codex >/dev/null
    exec /usr/local/bin/ccgram-launch
    ;;
  *)
    echo "hub-entrypoint: expected 'herdr' or 'ccgram'" >&2
    exit 2
    ;;
esac
