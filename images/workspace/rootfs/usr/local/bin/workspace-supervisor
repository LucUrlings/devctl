#!/usr/bin/env python3
from __future__ import annotations

import os
import signal
import subprocess
import sys
import time

processes: list[subprocess.Popen[bytes]] = []
shutting_down = False
shutdown_started = 0.0


def stop(signum: int, _frame: object) -> None:
    global shutting_down, shutdown_started
    shutting_down = True
    shutdown_started = shutdown_started or time.monotonic()
    for process in processes:
        if process.poll() is None:
            process.send_signal(signum)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
environment = os.environ.copy()
commands = [
    ["/usr/sbin/sshd", "-D", "-e"],
    [
        "runuser", "--user", "developer", "--", "env", "HOME=/home/developer", "code-server",
        "--bind-addr", "0.0.0.0:8080", "--auth", "none", "--disable-telemetry",
        "/workspace/project",
    ],
]
for command in commands:
    processes.append(subprocess.Popen(command, env=environment))

while True:
    if shutting_down:
        if all(process.poll() is not None for process in processes):
            raise SystemExit(0)
        if time.monotonic() - shutdown_started > 8:
            for process in processes:
                if process.poll() is None:
                    process.kill()
        time.sleep(0.2)
        continue
    for process in processes:
        code = process.poll()
        if code is not None:
            stop(signal.SIGTERM, None)
            for other in processes:
                if other.poll() is None:
                    other.wait(timeout=10)
            print(f"workspace-supervisor: child exited with {code}", file=sys.stderr)
            raise SystemExit(code or 1)
    time.sleep(1)
