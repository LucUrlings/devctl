# Copy to /srv/devctl/config/devctl.env and set every blank required value.
HUB_IMAGE=ghcr.io/lucurlings/devctl-hub:latest
WORKSPACE_IMAGE=ghcr.io/lucurlings/devctl-workspace:latest

TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_AUTH_MIDDLEWARE=
TRAEFIK_CERT_RESOLVER=
BASE_DOMAIN=
CODE_SUBDOMAIN=code
PREVIEW_SUBDOMAIN=dev

SSH_PORT_MIN=22000
SSH_PORT_MAX=22999
SSH_JUMP_HOST=dev-server
SSH_IDENTITY_FILE=~/.ssh/id_ed25519

DEFAULT_PREVIEW_PORT=3000
DEFAULT_AGENT=none
HEALTH_TIMEOUT=180
# Telegram/CCGram is entirely dormant unless explicitly enabled.
CCGRAM_ENABLED=false
ALLOW_SSH_GIT=false
# Optional explicit forwarded SSH-agent socket for SSH Git URLs. Never mount a private key.
GIT_SSH_AUTH_SOCK_HOST_PATH=
WORKSPACE_CPUS=4
WORKSPACE_MEMORY=8G
