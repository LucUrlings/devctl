#!/usr/bin/env bash
set -euo pipefail

readonly DEVCTL_LAUNCHER_VERSION=0.1.0
readonly root=/srv/devctl
readonly config_file=$root/config/devctl.env
readonly compose_file=$root/state/hub.compose.yml

die() {
  echo "devctl: $*" >&2
  exit 1
}

require_root() {
  [[ $(id -u) -eq 0 ]] || die "this operation writes server configuration; run it with sudo"
}

require_docker() {
  docker info >/dev/null 2>&1 || die "Docker is unavailable or this user cannot access it"
  docker compose version >/dev/null 2>&1 || die "the Docker Compose plugin is unavailable"
}

write_config() {
  [[ -e $config_file ]] && return
  local temporary
  temporary=$(mktemp "$root/state/devctl.env.XXXXXX")
  printf '%s\n' \
    '# Generated by devctl. Set the three blank Traefik values before creating a project.' \
    'HUB_IMAGE=ghcr.io/lucurlings/devctl-hub:latest' \
    'WORKSPACE_IMAGE=ghcr.io/lucurlings/devctl-workspace:latest' \
    'TRAEFIK_NETWORK=' \
    'TRAEFIK_ENTRYPOINT=websecure' \
    'TRAEFIK_AUTH_MIDDLEWARE=' \
    'TRAEFIK_CERT_RESOLVER=' \
    'BASE_DOMAIN=' \
    'CODE_SUBDOMAIN=code' \
    'PREVIEW_SUBDOMAIN=dev' \
    'SSH_PORT_MIN=22000' \
    'SSH_PORT_MAX=22999' \
    'SSH_JUMP_HOST=dev-server' \
    'SSH_IDENTITY_FILE=~/.ssh/id_ed25519' \
    'DEFAULT_PREVIEW_PORT=3000' \
    'DEFAULT_AGENT=none' \
    'HEALTH_TIMEOUT=180' \
    'CCGRAM_ENABLED=false' \
    'ALLOW_SSH_GIT=false' \
    'GIT_SSH_AUTH_SOCK_HOST_PATH=' \
    'WORKSPACE_CPUS=4' \
    'WORKSPACE_MEMORY=8G' > "$temporary"
  install -m 0600 "$temporary" "$config_file"
  rm -f -- "$temporary"
  echo "Created $config_file"
}

write_compose() {
  local temporary
  temporary=$(mktemp "$root/state/hub.compose.yml.XXXXXX")
  # The Compose substitutions below must remain literal in the generated file.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '# Generated by devctl. Rerun `sudo devctl init` instead of editing this file.' \
    'name: devctl-hub' \
    'services:' \
    '  hub:' \
    '    image: ${HUB_IMAGE}' \
    '    restart: unless-stopped' \
    '    environment:' \
    '      DEVCTL_ROOT: /srv/devctl' \
    '      XDG_CONFIG_HOME: /srv/devctl' \
    '      HERDR_CONFIG_PATH: /srv/devctl/herdr/config.toml' \
    '      HERDR_SOCKET_PATH: /srv/devctl/herdr/run/herdr.sock' \
    '      CCGRAM_DIR: /srv/devctl/ccgram' \
    '      CCGRAM_ENABLED: ${CCGRAM_ENABLED:-false}' \
    '      CCGRAM_MULTIPLEXER: herdr' \
    '      CLAUDE_CONFIG_DIR: /srv/devctl/shared/claude' \
    '      CODEX_HOME: /srv/devctl/shared/codex' \
    '      GH_CONFIG_DIR: /srv/devctl/shared/gh' \
    '      TELEGRAM_BOT_TOKEN_FILE: /srv/devctl/secrets/telegram-bot-token' \
    '      CCGRAM_CONFIG_FILE: /srv/devctl/config/ccgram.env' \
    '    volumes:' \
    '      - /srv/devctl:/srv/devctl' \
    '      - /var/run/docker.sock:/var/run/docker.sock' \
    '    labels:' \
    '      devctl.managed: "true"' \
    '      devctl.role: hub' \
    '    healthcheck:' \
    '      test: ["CMD", "/usr/local/bin/hub-healthcheck"]' \
    '      interval: 15s' \
    '      timeout: 8s' \
    '      retries: 8' \
    '      start_period: 20s' > "$temporary"
  install -m 0644 "$temporary" "$compose_file"
  rm -f -- "$temporary"
}

compose() {
  docker compose \
    --project-name devctl-hub \
    --env-file "$config_file" \
    --file "$compose_file" \
    "$@"
}

initialize() {
  require_root
  require_docker
  install -d -m 0755 "$root" "$root/config" "$root/herdr" "$root/herdr/run" \
    "$root/ccgram" "$root/projects" "$root/ssh" "$root/state"
  install -d -m 0700 "$root/secrets" "$root/shared" "$root/shared/codex" \
    "$root/shared/claude" "$root/shared/gh"
  if [[ ! -e $root/ssh/authorized_keys ]]; then
    install -m 0600 /dev/null "$root/ssh/authorized_keys"
  fi
  write_config
  write_compose
  compose pull hub
  compose up --detach hub
  echo "Devctl is running. Configure $config_file, add public keys to $root/ssh/authorized_keys, then run: devctl doctor"
}

upgrade() {
  require_root
  require_docker
  [[ -s $config_file ]] || die "run 'sudo devctl init' first"
  write_compose
  compose pull hub
  compose up --detach --force-recreate hub
  echo "Devctl hub upgraded. Workspaces remain unchanged until restarted."
}

hub_container() {
  local -a matches
  mapfile -t matches < <(
    docker ps \
      --filter label=devctl.managed=true \
      --filter label=devctl.role=hub \
      --format '{{.ID}}'
  )
  [[ ${#matches[@]} -eq 1 ]] || die "expected exactly one running Devctl hub; run 'sudo devctl init'"
  printf '%s\n' "${matches[0]}"
}

run_in_hub() {
  local container
  container=$(hub_container)
  if [[ -t 0 && -t 1 ]]; then
    docker exec -it "$container" devctl "$@"
  else
    docker exec "$container" devctl "$@"
  fi
}

case ${1:-} in
  init)
    [[ $# -eq 1 ]] || die "usage: devctl init"
    initialize
    ;;
  upgrade)
    [[ $# -eq 1 ]] || die "usage: devctl upgrade"
    upgrade
    ;;
  config-path)
    [[ $# -eq 1 ]] || die "usage: devctl config-path"
    printf '%s\n' "$config_file"
    ;;
  launcher-version)
    [[ $# -eq 1 ]] || die "usage: devctl launcher-version"
    printf '%s\n' "$DEVCTL_LAUNCHER_VERSION"
    ;;
  telegram)
    if [[ ${2:-} == configure ]]; then
      require_root
      run_in_hub "$@"
      write_compose
      compose up --detach --force-recreate hub
      echo "Telegram configuration applied to the recreated hub."
    else
      run_in_hub "$@"
    fi
    ;;
  '')
    run_in_hub --help
    ;;
  *)
    run_in_hub "$@"
    ;;
esac
